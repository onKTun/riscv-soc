    {"id":"CHK_038_load_store_destination","field_path":"6.6 Output timing and safety invariants","requirement":"Loads enable and stores disable destination-register writeback","trigger":"load or store in E1","routing":"Approved"},
    {"id":"CHK_039_branch_class","field_path":"6.6 Output timing and safety invariants","requirement":"Branches select the ALU execution class","trigger":"branch in E1","routing":"Approved"},
    {"id":"CHK_040_stall_cause","field_path":"6.3 Data integrity and stability","requirement":"Every pipeline stall has a divide load or store cause","trigger":"pipeline stall","routing":"Approved"}
