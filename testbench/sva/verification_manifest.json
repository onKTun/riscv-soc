  "reference": "SVA_VERIFICATION_PLAN.md",
  "checks": [
    {"id":"CHK_001_reset_quiet","field_path":"6.1 Reset and initialization","requirement":"No AXI request is active while reset is sampled high","trigger":"rst_i","routing":"Approved"},
    {"id":"CHK_002_icache_refill","field_path":"6.2 Protocol and handshake behavior","requirement":"I-cache refill requests are aligned eight-beat INCR bursts","trigger":"instruction AR handshake","routing":"Approved"},
    {"id":"CHK_003_icache_response","field_path":"6.2 Protocol and handshake behavior","requirement":"Instruction RLAST is accompanied by RVALID","trigger":"instruction final read beat","routing":"Approved"},
    {"id":"CHK_004_dcache_read","field_path":"6.2 Protocol and handshake behavior","requirement":"D-cache reads are word-aligned INCR transactions","trigger":"data AR handshake","routing":"Approved"},
    {"id":"CHK_005_dcache_write","field_path":"6.3 Data integrity and stability","requirement":"Every D-cache write beat enables at least one byte lane","trigger":"data W handshake","routing":"Approved"},
    {"id":"CHK_006_dcache_response","field_path":"6.2 Protocol and handshake behavior","requirement":"Data RLAST is accompanied by RVALID","trigger":"data read or write response","routing":"Approved"},
    {"id":"CHK_007_icache_fsm","field_path":"6.4 FSM behavior","requirement":"I-cache state remains legal and REFILL is reached","trigger":"I-cache REFILL state","routing":"Approved","hierarchy":"dut.u_icache.state_q"},
    {"id":"CHK_008_dcache_fsm","field_path":"6.4 FSM behavior","requirement":"D-cache state remains legal and REFILL is reached","trigger":"D-cache REFILL state","routing":"Approved","hierarchy":"dut.u_dcache.u_core.state_q"},
    {"id":"CHK_009_reset_states","field_path":"6.1 Reset and initialization","requirement":"Both caches remain in their defined reset states while reset is active","trigger":"rst_i","routing":"Approved"},
    {"id":"CHK_010_icache_read_only","field_path":"6.6 Output timing and safety invariants","requirement":"The instruction cache never issues AXI writes","trigger":"instruction AXI activity","routing":"Approved"},
    {"id":"CHK_011_fetch_alignment","field_path":"6.5 Counters, FIFOs, and resources","requirement":"Instruction fetch requests are word aligned","trigger":"core instruction request","routing":"Approved","hierarchy":"dut.icache_pc_w"},
    {"id":"CHK_012_core_data_request","field_path":"6.6 Output timing and safety invariants","requirement":"The core never requests a data read and write simultaneously","trigger":"core data request","routing":"Approved"},
    {"id":"CHK_013_icache_refill_exit","field_path":"6.4 FSM behavior","requirement":"A completed I-cache refill transitions to RELOOKUP","trigger":"I-cache final refill beat","routing":"Approved","hierarchy":"dut.u_icache.state_q"},
    {"id":"CHK_014_icache_relookup","field_path":"6.4 FSM behavior","requirement":"I-cache RELOOKUP transitions to LOOKUP on the next clock","trigger":"I-cache RELOOKUP state","routing":"Approved","hierarchy":"dut.u_icache.state_q"},
    {"id":"CHK_015_dcache_refill_exit","field_path":"6.4 FSM behavior","requirement":"A completed D-cache refill transitions to READ or WRITE","trigger":"D-cache final refill acknowledgement","routing":"Approved","hierarchy":"dut.u_dcache.u_core.state_q"},
    {"id":"CHK_016_axi_response","field_path":"6.2 Protocol and handshake behavior","requirement":"Instruction reads, data reads, and data writes receive OKAY responses","trigger":"any AXI response","routing":"Approved"},
    {"id":"CHK_017_clock_period","field_path":"6.6 Output timing and safety invariants","requirement":"The default simulation clock period remains 10 ns (100 MHz)","trigger":"two consecutive rising clock edges","routing":"Approved"},
    {"id":"CHK_018_clock_duty","field_path":"6.6 Output timing and safety invariants","requirement":"Clock high and low times are each 5 ns","trigger":"rising and falling clock edges","routing":"Approved"},
    {"id":"CHK_019_reset_duration","field_path":"6.1 Reset and initialization","requirement":"Startup reset remains active for at least five rising clock edges","trigger":"falling edge of rst_i","routing":"Approved"},
    {"id":"CHK_020_reset_release","field_path":"6.1 Reset and initialization","requirement":"Reset remains inactive on the clock after release","trigger":"falling edge of rst_i","routing":"Approved"},
    {"id":"CHK_021_post_reset_quiet","field_path":"6.1 Reset and initialization","requirement":"No AXI request is active on the first sampled clock after reset release","trigger":"falling edge of rst_i","routing":"Approved"},
    {"id":"CHK_022_pipeline_reset","field_path":"6.1 Reset and initialization","requirement":"E1, E2, and writeback valid/control registers clear during reset","trigger":"rst_i","routing":"Approved","hierarchy":"dut.u_core.u_issue.u_pipe_ctrl"},
    {"id":"CHK_023_load_store_exclusion","field_path":"6.6 Output timing and safety invariants","requirement":"No pipeline stage is simultaneously classified as load and store","trigger":"load or store in E1","routing":"Approved"},
    {"id":"CHK_024_operation_class","field_path":"6.6 Output timing and safety invariants","requirement":"Load, store, CSR, divide, and multiply controls are one-hot-or-zero","trigger":"special operation in E1","routing":"Approved"},
    {"id":"CHK_025_invalid_stage_clear","field_path":"6.3 Data integrity and stability","requirement":"An invalid E1 stage has no active control bits","trigger":"invalid E1 stage","routing":"Approved"},
    {"id":"CHK_026_pipeline_stall","field_path":"6.3 Data integrity and stability","requirement":"Pipeline valid, control, PC, and opcode registers remain stable across stalls","trigger":"issue pipeline stall","routing":"Approved"},
    {"id":"CHK_028_zero_register","field_path":"6.3 Data integrity and stability","requirement":"Reading source register x0 produces zero","trigger":"RA index equals zero","routing":"Approved"},
    {"id":"CHK_029_pipeline_pc","field_path":"6.5 Counters, FIFOs, and resources","requirement":"Valid E1, E2, and writeback PCs are word aligned","trigger":"valid writeback stage","routing":"Approved"},
    {"id":"CHK_030_branch_control","field_path":"6.6 Output timing and safety invariants","requirement":"Branch outcome controls are exclusive and requested targets are aligned","trigger":"branch request","routing":"Approved"},
    {"id":"CHK_031_pipeline_progress","field_path":"6.3 Data integrity and stability","requirement":"Valid unstalled unsquashed E1 instructions advance to E2","trigger":"eligible E1 instruction","routing":"Approved"},
    {"id":"CHK_032_pipeline_complete","field_path":"6.6 Output timing and safety invariants","requirement":"Every valid pipeline stage carries COMPLETE control","trigger":"E1 E2 and writeback simultaneously valid","routing":"Approved"},
    {"id":"CHK_033_e1_e2_metadata","field_path":"6.3 Data integrity and stability","requirement":"PC opcode and controls propagate unchanged from E1 to E2","trigger":"eligible E1 instruction","routing":"Approved"},
    {"id":"CHK_034_e2_wb_metadata","field_path":"6.3 Data integrity and stability","requirement":"Non-exception PC opcode and controls propagate unchanged from E2 to writeback","trigger":"eligible E2 instruction","routing":"Approved"},
    {"id":"CHK_035_add_result","field_path":"4 Verification objectives[5]","requirement":"ADD and ADDI writeback results equal independently computed sums","trigger":"committed ADD or ADDI","routing":"Approved"},
    {"id":"CHK_036_lui_result","field_path":"4 Verification objectives[5]","requirement":"LUI writeback equals its encoded upper immediate","trigger":"committed LUI","routing":"Approved"},
