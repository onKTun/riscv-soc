{
  "backend": "verilator_sva",
  "language": "SystemVerilog",
  "dut_top_module": "riscv_top",
  "generated_top": "riscv_top_tb",
  "generated_file": "riscv_top_tb.sv",
  "dut_instance": "dut",
  "clock": {
    "port": "clk_i",
    "edge": "posedge",
    "period_ns": 10,
    "defaulted": true
  },
  "reset": {
    "port": "rst_i",
    "active_level": 1,
    "style": "asynchronous RTL reset, sampled synchronously by SVA",
    "duration_cycles": 5
  },
  "watchdog_cycles": 3000,
  "waveform": "riscv_top.vcd",
  "coverage": "explicit cover property with Verilator --coverage-user",
  "reference": "SVA_VERIFICATION_PLAN.md",
  "checks": [
    {"id":"CHK_001_reset_quiet","field_path":"6.1 Reset and initialization","requirement":"No AXI request is active while reset is sampled high","trigger":"rst_i","routing":"Approved"},
    {"id":"CHK_002_icache_refill","field_path":"6.2 Protocol and handshake behavior","requirement":"I-cache refill requests are aligned eight-beat INCR bursts","trigger":"instruction AR handshake","routing":"Approved"},
    {"id":"CHK_003_icache_response","field_path":"6.2 Protocol and handshake behavior","requirement":"Instruction RLAST is accompanied by RVALID","trigger":"instruction final read beat","routing":"Approved"},
    {"id":"CHK_004_dcache_read","field_path":"6.2 Protocol and handshake behavior","requirement":"D-cache reads are word-aligned INCR transactions","trigger":"data AR handshake","routing":"Approved"},
    {"id":"CHK_005_dcache_write","field_path":"6.3 Data integrity and stability","requirement":"Every D-cache write beat enables at least one byte lane","trigger":"data W handshake","routing":"Approved"},
    {"id":"CHK_006_dcache_response","field_path":"6.2 Protocol and handshake behavior","requirement":"Data RLAST is accompanied by RVALID","trigger":"data read or write response","routing":"Approved"},
    {"id":"CHK_007_icache_fsm","field_path":"6.4 FSM behavior","requirement":"I-cache state remains legal and REFILL is reached","trigger":"I-cache REFILL state","routing":"Approved","hierarchy":"dut.u_icache.state_q"},
    {"id":"CHK_008_dcache_fsm","field_path":"6.4 FSM behavior","requirement":"D-cache state remains legal and REFILL is reached","trigger":"D-cache REFILL state","routing":"Approved","hierarchy":"dut.u_dcache.u_core.state_q"},
    {"id":"CHK_009_reset_states","field_path":"6.1 Reset and initialization","requirement":"Both caches remain in their defined reset states while reset is active","trigger":"rst_i","routing":"Approved"},
    {"id":"CHK_010_icache_read_only","field_path":"6.6 Output timing and safety invariants","requirement":"The instruction cache never issues AXI writes","trigger":"instruction AXI activity","routing":"Approved"},
    {"id":"CHK_011_fetch_alignment","field_path":"6.5 Counters, FIFOs, and resources","requirement":"Instruction fetch requests are word aligned","trigger":"core instruction request","routing":"Approved","hierarchy":"dut.icache_pc_w"},
    {"id":"CHK_012_core_data_request","field_path":"6.6 Output timing and safety invariants","requirement":"The core never requests a data read and write simultaneously","trigger":"core data request","routing":"Approved"},
    {"id":"CHK_013_icache_refill_exit","field_path":"6.4 FSM behavior","requirement":"A completed I-cache refill transitions to RELOOKUP","trigger":"I-cache final refill beat","routing":"Approved","hierarchy":"dut.u_icache.state_q"},
    {"id":"CHK_014_icache_relookup","field_path":"6.4 FSM behavior","requirement":"I-cache RELOOKUP transitions to LOOKUP on the next clock","trigger":"I-cache RELOOKUP state","routing":"Approved","hierarchy":"dut.u_icache.state_q"},
    {"id":"CHK_015_dcache_refill_exit","field_path":"6.4 FSM behavior","requirement":"A completed D-cache refill transitions to READ or WRITE","trigger":"D-cache final refill acknowledgement","routing":"Approved","hierarchy":"dut.u_dcache.u_core.state_q"},
    {"id":"CHK_016_axi_response","field_path":"6.2 Protocol and handshake behavior","requirement":"Instruction reads, data reads, and data writes receive OKAY responses","trigger":"any AXI response","routing":"Approved"}
  ]
}
